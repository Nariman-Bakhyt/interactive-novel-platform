# ==========================================
# WénLib Backend Environment Variables
# ==========================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=website
DB_USERNAME=postgres
DB_PASSWORD=postgres

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Security Secrets (Must be changed in production!)
JWT_SECRET_KEY=dGhpcy1pcy1hLXNlY3VyZS0yNTYtYml0LXNlY3JldC1rZXktZm9yLWp3dC10b2tlbnM=
PASSWORD_PEPPER=default_password_pepper_key_123
APP_GUEST_SECRET=guest_secret_key_1234567890_default
JWT_EXPIRATION_MS=604800000

# MinIO S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=media

# Redis / Valkey Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=postgres

# Mail / SMTP Configuration
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=dev@example.com
MAIL_PASSWORD=devpassword
